[project]
name = "{{app_name}}"
version = "0.0.0"  # Version managed in root pyproject.toml
description = "FastAPI app with Cognito authentication"
requires-python = ">={{python_version}}"
dependencies = [
    "cognito-auth[fastapi]>=0.5.4",
    "uvicorn[standard]>=0.27.0",
]

[tool.uv.sources]
cognito-auth = { index = "gds-idea" }
gds-idea-pkg-zscaler-fix = { index = "gds-idea" }

[[tool.uv.index]]
name = "gds-idea"
url = "https://co-cddo.github.io/gds-idea-pypi/simple/"

[tool.ruff]
line-length = 100
target-version = "py{{python_version_nodot}}"

[tool.ruff.lint]
select = [
    "E",   # pycodestyle errors
    "W",   # pycodestyle warnings
    "F",   # pyflakes
    "I",   # isort
    "N",   # pep8-naming
    "UP",  # pyupgrade
]
ignore = []

[tool.ruff.lint.isort]
known-first-party = ["{{app_name}}"]

[tool.pytest.ini_options]
pythonpath = ["."]
testpaths = ["tests"]

[dependency-groups]
dev = [
    "pytest>=9.0.0",
]
# Zscaler TLS fix for Python. Development only: it relaxes a certificate check,
# so it must never reach production. The Dockerfile's production build uses
# `uv sync --no-default-groups`, which leaves out every default group.
# https://github.com/co-cddo/gds-idea-pkg-zscaler-fix
zscaler = [
    "gds-idea-pkg-zscaler-fix>=0.1.2",
]

[tool.uv]
# A plain `uv sync` installs these groups (and keeps them, rather than removing
# packages that aren't in the lockfile).
default-groups = ["dev", "zscaler"]
